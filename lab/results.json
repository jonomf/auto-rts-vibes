   "addons": "attached",
   "abilities": "manual"
  },
  "streamlined": {
   "id": "streamlined",
   "name": "Streamlined",
   "blurb": "Automation-friendly: soft supply cap (over-cap units train 3× slower), add-ons have no footprint, tanks siege and bio stims by themselves.",
